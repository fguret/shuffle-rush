{
  // Checks src/ with the compiler settings the SPFx build rig uses
  // (target ES5, Node module resolution, classic JSX, a small lib set),
  // so code that only works with newer settings is caught before the SPFx build.
  "compilerOptions": {
    "target": "es5",
    "lib": ["es5", "dom", "es2015.collection", "es2015.promise"],
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["../src", "./vite-env.d.ts"],
  "exclude": [
    "../src/webparts/**/*WebPart.ts",
    "../src/webparts/**/loc/**"
  ]
}
