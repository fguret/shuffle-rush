{
  "name": "assurance-learning-calendar",
  "version": "1.0.0",
  "private": true,
  "description": "Assurance Virtual Learning Enrollment Calendar - React source for the SPFx web part assuranceLearningCalendar, with a local test harness.",
  "scripts": {
    "dev:local": "vite --config dev/vite.config.mts",
    "build:local": "tsc -p dev/tsconfig.json && vite build --config dev/vite.config.mts",
    "typecheck:local": "tsc -p dev/tsconfig.json",
    "sample-csv": "node scripts/make-sample-csv.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "sass": "1.83.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
